# Optional local Compose settings. No .env is required.
PORT=8000
INGRESS_PORT=8001
DEMO_OPERATOR_TOKEN=
BASELINE_MODE=extractive
MAX_RUNNING=2
MAX_PENDING=100
MODEL_REQUESTS_PER_MINUTE=20
TOKEN_BUDGET=1000000
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_SYNTHETIC_CONTENT=false
# Render/direct Docker only, set securely in hosting. Compose uses its own DB.
DATABASE_URL=
START_WORKER=true
AI_BASE_URL=
