DEMO_OPERATOR_TOKEN=
BASELINE_MODE=extractive
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_SYNTHETIC_CONTENT=false
