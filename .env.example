# Optional local Compose settings. No .env is required.
PORT=8000
INGRESS_PORT=8001
DEMO_OPERATOR_TOKEN=
BASELINE_MODE=extractive
MAX_RUNNING=2
MAX_PENDING=100
MODEL_REQUESTS_PER_MINUTE=20
TOKEN_BUDGET=1000000
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_SYNTHETIC_CONTENT=false
# Render/direct Docker only, set securely in hosting. Compose uses its own DB.
DATABASE_URL=
START_WORKER=true
AI_BASE_URL=

# LAB04 identity-bound UTC daily quotas; no secret values belong in this file.
USER_REQUESTS_PER_DAY=100
USER_MODEL_CALLS_PER_DAY=100
USER_TOKENS_PER_DAY=1000000
ANOMALY_TOKENS_PER_MINUTE=200000
OPERATOR_TOKENS=
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=18300
GRAFANA_PORT=18301
ALERTMANAGER_PORT=18302
LOKI_PORT=18500
TEMPO_PORT=18600
