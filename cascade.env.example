# Opt-in cascade. Keep secrets in an ignored .env.cascade file.
CASCADE_LIVE_ENABLED=false
SOL_LIVE_ENABLED=false
MISTRAL_FREE_CONFIRMED=false
# Free-stand defaults; set according to the project's actual quota.
MISTRAL_REQUESTS_PER_MINUTE=2
MISTRAL_MAX_RUNNING=1
TOKEN_BUDGET=20000000
CASCADE_BUDGET_RUB=10
MISTRAL_API_KEY=
APIMIRA_API_KEY=
# Optional trusted CA inside AI container, never a local machine path.
CASCADE_CA_FILE=
