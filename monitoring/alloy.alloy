local.file_match "triage" {
  path_targets = [{"__path__" = "/logs/*.jsonl", "job" = "support-triage"}]
  sync_period = "1s"
}
loki.source.file "triage" {
  targets = local.file_match.triage.targets
  forward_to = [loki.process.triage.receiver]
}
loki.process "triage" {
  stage.json { expressions = { service = "service" } }
  stage.labels { values = { service = "" } }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
